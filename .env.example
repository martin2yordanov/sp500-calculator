# ---------------------------------------------------------------------------
# Копирай в `.env.local` за разработка. В Vercel същите стойности се въвеждат
# в Settings → Environment Variables.
#
# Всички са опционални: без тях калкулаторът работи, просто не предлага вход.
# ---------------------------------------------------------------------------

# --- вграждат се в бандъла (видими са за всеки, който отвори приложението) ---

# Публичният ключ на Clerk. Без него приложението не показва бутон за вход
# изобщо — няма счупен бутон, просто липсва.
# Clerk Dashboard → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=

# Абсолютният адрес, на който са качени функциите от `api/`.
# За native билда се задава от `npm run build:native` в package.json.
# За уеб билда трябва да остане празен: тогава се ползват относителни пътища и
# всеки preview деплой вика собствените си функции вместо продукционните.
VITE_API_BASE_URL=

# --- само на сървъра (НЕ започват с VITE_ и не влизат в бандъла) -----------

# Clerk Dashboard → API Keys → Secret key
CLERK_SECRET_KEY=

# Кои `azp` claim-ове се приемат, разделени със запетая. Спира токен, издаден
# за друг сайт, да бъде подаден на това API. За iOS билда добави
# `https://localhost` — това е origin-ът на WebView-а.
# пример: https://sp500-app.vercel.app,https://localhost
CLERK_AUTHORIZED_PARTIES=

# Допълнителни origin-и, на които функциите отговарят с CORS хедъри.
# `https://localhost`, `capacitor://localhost` и `ionic://localhost` са
# позволени по подразбиране, защото това са origin-ите на native билда.
ALLOWED_ORIGINS=
