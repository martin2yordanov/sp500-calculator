{
  "name": "sp500-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:native": "VITE_API_BASE_URL=https://sp500-app.vercel.app vite build",
    "cap:sync": "npm run build:native && cap sync",
    "cap:open:ios": "npm run cap:sync && cap open ios",
    "assets:generate": "capacitor-assets generate --ios --splashBackgroundColor '#0b0f10' --splashBackgroundColorDark '#0b0f10'"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
